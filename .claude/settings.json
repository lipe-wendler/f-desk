{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/revisao-de-seguranca.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(gh pr create*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/revisao-de-seguranca.mjs\""
          }
        ]
      }
    ]
  }
}
