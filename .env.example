# Copie para .env na raiz (nunca versione o .env). Os scripts leem .env e depois .env.local.
# Na Vercel, cadastre as mesmas variáveis no projeto f-desk para Production e Preview.

# Neon Postgres — localmente, `neon link`/`neon env pull` grava em .env.local; na Vercel, a integração
# Neon preenche sozinha (e cria um branch de banco por preview).
DATABASE_URL=

# better-auth — gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do app (site e API no mesmo domínio). Em dev: http://localhost:5173.
# Em previews da Vercel pode ficar vazia: a URL do deploy é usada automaticamente.
BETTER_AUTH_URL=http://localhost:5173
# Origens extras aceitas no login, separadas por vírgula (opcional).
TRUSTED_ORIGINS=

# Chat (Wen): perguntas fora do FAQ vão para o LLM em LLM_MODEL (<provedor>:<modelo>).
# Provedores: google, anthropic, openai, xai. Só a chave do provedor escolhido é necessária;
# sem ela, o chat responde só pelo FAQ.
LLM_MODEL=google:gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Limite do chat por IP (visitante) ou por conta (logado). Padrão: 20 mensagens a cada 600 s.
CHAT_RATE_LIMIT=
CHAT_RATE_WINDOW_SECONDS=

# Primeiro admin da plataforma — só para `pnpm --filter api seed:admin` (não precisa na Vercel).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin F.Desk
