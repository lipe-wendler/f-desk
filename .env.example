# Copie para .env na raiz (nunca versione o .env). Na Vercel, cadastre as mesmas variáveis
# no projeto f-desk para Production e Preview.

# Neon Postgres — a integração Neon da Vercel preenche sozinha (e cria um branch de banco por preview).
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/f_desk?sslmode=require

# better-auth — gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do app (site e API no mesmo domínio). Em dev: http://localhost:5173.
# Em previews da Vercel pode ficar vazia: a URL do deploy é usada automaticamente.
BETTER_AUTH_URL=http://localhost:5173
# Origens extras aceitas no login, separadas por vírgula (opcional).
TRUSTED_ORIGINS=

# Claude API (chatbot) — usada a partir da tarefa feat/chatbot-faq-e-llm.
ANTHROPIC_API_KEY=

# Primeiro admin da plataforma — só para `pnpm --filter api seed:admin` (não precisa na Vercel).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin F.Desk
