{
  "name": "@f-desk/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./theme.css": "./src/styles/theme.css",
    "./tokens.json": "./src/tokens/tokens.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "check:tokens": "node scripts/build-tokens.ts --check",
    "check:contrast": "node scripts/check-contrast.ts",
    "lint": "eslint .",
    "typecheck": "vue-tsc -p tsconfig.json",
    "test": "pnpm check:tokens && pnpm check:contrast && vitest run"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@f-desk/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue-router": ">=4"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  }
}
